rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /licenses/{licenseId} {
      // Read-only Spark architecture. The administrator creates/updates licenses
      // in the Firebase Console. The APK never writes license data.
      allow get: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && resource.data.status == 'active'
        && resource.data.packageName == 'com.example.saudi_anpr'
        && resource.data.loginEmail == request.auth.token.email
        && resource.data.expiresAt is timestamp
        && resource.data.expiresAt > request.time;

      allow create, update, delete: if false;
      allow list: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
