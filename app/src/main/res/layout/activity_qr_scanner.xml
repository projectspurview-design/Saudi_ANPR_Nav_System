<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- Compact camera surface: deliberately small for M400 HUD viewing. -->
    <androidx.camera.view.PreviewView
        android:id="@+id/qrPreview"
        android:layout_width="230dp"
        android:layout_height="230dp"
        android:layout_gravity="center"
        android:contentDescription="QR scanner camera preview" />

    <View
        android:layout_width="230dp"
        android:layout_height="230dp"
        android:layout_gravity="center"
        android:background="@drawable/qr_scan_frame"
        android:clickable="false"
        android:focusable="false" />

    <TextView
        android:id="@+id/scannerStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginStart="12dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="12dp"
        android:gravity="center"
        android:text="Look at the QR code inside the small box"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:maxLines="2" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/cancelScannerButton"
        style="@style/Widget.SaudiAnpr.Button"
        android:layout_width="120dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="14dp"
        android:minHeight="48dp"
        android:text="CANCEL"
        android:textSize="13sp" />

</FrameLayout>
