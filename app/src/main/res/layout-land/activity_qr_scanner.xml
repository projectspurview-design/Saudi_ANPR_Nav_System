<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <androidx.camera.view.PreviewView
        android:id="@+id/qrPreview"
        android:layout_width="190dp"
        android:layout_height="190dp"
        android:layout_gravity="center"
        android:contentDescription="QR scanner camera preview" />

    <View
        android:layout_width="190dp"
        android:layout_height="190dp"
        android:layout_gravity="center"
        android:background="@drawable/qr_scan_frame"
        android:clickable="false"
        android:focusable="false" />

    <TextView
        android:id="@+id/scannerStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginStart="10dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="10dp"
        android:gravity="center"
        android:text="Look at the QR code inside the small box"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:maxLines="2" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/cancelScannerButton"
        style="@style/Widget.SaudiAnpr.Button"
        android:layout_width="100dp"
        android:layout_height="42dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="8dp"
        android:minHeight="42dp"
        android:text="CANCEL"
        android:textSize="11sp" />

</FrameLayout>
