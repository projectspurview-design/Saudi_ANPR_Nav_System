<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Saudi_Anpr" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary color. -->
        <item name="colorSecondary">@color/button_gray</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/bg_dark</item>

        <!-- Background colors -->
        <item name="android:windowBackground">@color/bg_dark</item>

        <!-- Default text colors -->
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="Theme.Saudi_Anpr" parent="Base.Theme.Saudi_Anpr" />

    <!-- Custom Button Style -->
    <style name="Widget.SaudiAnpr.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/button_gray</item>
        <item name="android:textColor">@color/white</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.SaudiAnpr.MediumComponent</item>
    </style>

    <!-- Shape Appearance -->
    <style name="ShapeAppearance.SaudiAnpr.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">8dp</item>
    </style>
</resources>
